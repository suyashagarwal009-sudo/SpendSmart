{
  "name": "spendsmart-backend",
  "version": "1.0.0",
  "description": "SpendSmart Phase 4/5 - Express REST API for expenses and monthly budgets, persisting to MongoDB via Mongoose with an in-memory fallback.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "spendsmart",
    "express",
    "rest-api",
    "expense-tracker"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.24.10"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
