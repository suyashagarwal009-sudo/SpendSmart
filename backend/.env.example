# SpendSmart backend environment
# Copy this file to .env and adjust the values for your machine.
#   Windows (cmd):  copy .env.example .env
#   Windows (pwsh): Copy-Item .env.example .env

# Port the API listens on
PORT=5000

# "development" or "production". In production, internal error details
# are hidden from API responses.
NODE_ENV=development

# Comma-separated list of origins the browser may call this API from.
# 5500 is the default port of VS Code Live Server; 3000 is a common
# dev-server port for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Phase 5 (MongoDB) will use this. Leave empty until then - the API runs
# on temporary in-memory storage while this is unset.
MONGO_URI=
